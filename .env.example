# Copy this file to .env and fill in the values. Never commit .env.

# Database (MySQL). Leave DB_NAME out to use SQLite (db.sqlite3) instead.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ban2plans
DB_USER=root
DB_PASSWORD=

# Gmail account the website sends enquiry emails FROM.
# EMAIL_HOST_PASSWORD must be a Google "App password", not the normal password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional overrides (defaults shown)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# Inbox that receives enquiries
ENQUIRY_EMAIL_TO=ravidarshan95@gmail.com

# Frontend addresses allowed to call the API from another host/port (comma-separated)
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
